{
  "datasets": [
    {
      "name": "kpi_criticos",
      "displayName": "KPI - Datos Críticos",
      "queryLines": [
        "SELECT\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN dato_critico = 'SÍ' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS criticos\n",
        "FROM\n",
        "  catalog_au.silver.conceptos_calidad_trazabilidad"
      ]
    },
    {
      "name": "kpi_total",
      "displayName": "KPI - Total Entidades",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total\n",
        "FROM\n",
        "  catalog_au.silver.conceptos_calidad_trazabilidad"
      ]
    },
    {
      "name": "kpi_subdominios",
      "displayName": "KPI - Subdominios",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT nombre_del_subdominio) AS subdominios\n",
        "FROM\n",
        "  catalog_au.silver.conceptos_calidad_trazabilidad"
      ]
    },
    {
      "name": "kpi_reglas",
      "displayName": "KPI - Con Regla de Calidad",
      "queryLines": [
        "SELECT\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        id_regla_de_calidad IS NOT NULL\n",
        "        AND id_regla_de_calidad != ''\n",
        "      THEN\n",
        "        1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS con_regla\n",
        "FROM\n",
        "  catalog_au.silver.conceptos_calidad_trazabilidad"
      ]
    },
    {
      "name": "kpi_trazabilidad",
      "displayName": "KPI - Con Trazabilidad",
      "queryLines": [
        "SELECT\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        tabla_en_fuente_oficial IS NOT NULL\n",
        "        AND tabla_en_fuente_oficial != ''\n",
        "      THEN\n",
        "        1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS con_traz\n",
        "FROM\n",
        "  catalog_au.silver.conceptos_calidad_trazabilidad"
      ]
    },
    {
      "name": "clasificacion_dominio",
      "displayName": "Clasificación por Dominio",
      "queryLines": [
        "SELECT\n",
        "  nombre_del_dominio,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN dato_critico = 'SÍ' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS datos_criticos,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN personal = 'SÍ' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS datos_personales,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN sensible = 'SÍ' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS datos_sensibles\n",
        "FROM\n",
        "  catalog_au.silver.conceptos_calidad_trazabilidad\n",
        "GROUP BY\n",
        "  nombre_del_dominio\n",
        "ORDER BY\n",
        "  nombre_del_dominio"
      ]
    },
    {
      "name": "kpi_dominios",
      "displayName": "KPI - Dominios",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT nombre_del_dominio) AS dominios\n",
        "FROM\n",
        "  catalog_au.silver.conceptos_calidad_trazabilidad"
      ]
    },
    {
      "name": "principios_calidad",
      "displayName": "Reglas de Calidad por Principio y Dominio",
      "queryLines": [
        "SELECT\n",
        "  nombre_del_dominio,\n",
        "  principio_de_calidad_asociado,\n",
        "  COUNT(*) AS cantidad_reglas\n",
        "FROM\n",
        "  catalog_au.silver.conceptos_calidad_trazabilidad\n",
        "WHERE\n",
        "  id_regla_de_calidad IS NOT NULL\n",
        "  AND id_regla_de_calidad != ''\n",
        "GROUP BY\n",
        "  nombre_del_dominio,\n",
        "  principio_de_calidad_asociado\n",
        "ORDER BY\n",
        "  cantidad_reglas DESC"
      ]
    },
    {
      "name": "completitud",
      "displayName": "Completitud del Diccionario por Subdominio",
      "queryLines": [
        "SELECT\n",
        "  nombre_del_subdominio,\n",
        "  nombre_del_dominio,\n",
        "  COUNT(*) AS total_entidades,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN\n",
        "          concepto_de_negocio IS NOT NULL\n",
        "          AND concepto_de_negocio != ''\n",
        "        THEN\n",
        "          1\n",
        "        ELSE 0\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) AS pct_concepto_negocio,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN\n",
        "          id_regla_de_calidad IS NOT NULL\n",
        "          AND id_regla_de_calidad != ''\n",
        "        THEN\n",
        "          1\n",
        "        ELSE 0\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) AS pct_regla_calidad,\n",
        "  ROUND(\n",
        "    SUM(\n",
        "      CASE\n",
        "        WHEN\n",
        "          tabla_en_fuente_oficial IS NOT NULL\n",
        "          AND tabla_en_fuente_oficial != ''\n",
        "        THEN\n",
        "          1\n",
        "        ELSE 0\n",
        "      END\n",
        "    )\n",
        "      * 100.0\n",
        "      / COUNT(*),\n",
        "    1\n",
        "  ) AS pct_trazabilidad,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        concepto_de_negocio IS NULL\n",
        "        OR concepto_de_negocio = ''\n",
        "      THEN\n",
        "        1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS sin_concepto,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        id_regla_de_calidad IS NULL\n",
        "        OR id_regla_de_calidad = ''\n",
        "      THEN\n",
        "        1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS sin_regla_calidad,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN\n",
        "        tabla_en_fuente_oficial IS NULL\n",
        "        OR tabla_en_fuente_oficial = ''\n",
        "      THEN\n",
        "        1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS sin_trazabilidad\n",
        "FROM\n",
        "  catalog_au.silver.conceptos_calidad_trazabilidad\n",
        "GROUP BY\n",
        "  nombre_del_subdominio,\n",
        "  nombre_del_dominio\n",
        "ORDER BY\n",
        "  nombre_del_dominio,\n",
        "  total_entidades DESC"
      ]
    },
    {
      "name": "prioridad",
      "displayName": "Distribución por Prioridad",
      "queryLines": [
        "SELECT\n",
        "  prioridad_del_entidad_de_dato,\n",
        "  COUNT(*) AS cantidad\n",
        "FROM\n",
        "  catalog_au.silver.conceptos_calidad_trazabilidad\n",
        "WHERE\n",
        "  prioridad_del_entidad_de_dato IS NOT NULL\n",
        "GROUP BY\n",
        "  prioridad_del_entidad_de_dato\n",
        "ORDER BY\n",
        "  CASE prioridad_del_entidad_de_dato\n",
        "    WHEN 'Alta' THEN 1\n",
        "    WHEN 'Media' THEN 2\n",
        "    WHEN 'Baja' THEN 3\n",
        "    ELSE 4\n",
        "  END"
      ]
    }
  ],
